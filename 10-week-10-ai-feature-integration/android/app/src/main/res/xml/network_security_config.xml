<?xml version="1.0" encoding="utf-8"?>
<!--
  Izin cleartext hanya untuk alamat pengujian lokal (emulator ke host):
  - 10.0.2.2   : alias host PC dari emulator Android
  - 127.0.0.1  : localhost perangkat
  Sisanya tetap wajib HTTPS, sesuai tabel risiko privasi di README Minggu 10.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
